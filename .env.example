# Everything here is OPTIONAL. Visitors can pick a provider, model and key under
# "API settings" on the page, so the site runs with no .env at all.
# Use these only to provide a default (for example your own key) for everyone.

# --- Default provider ---
# anthropic | openrouter | openai | ollama | custom   (default: anthropic)
AI_PROVIDER=anthropic

# --- Optional server-side key for the default provider ---
#   anthropic  -> ANTHROPIC_API_KEY   (https://console.anthropic.com)
#   openrouter -> OPENROUTER_API_KEY  (https://openrouter.ai/settings/keys)
#   openai     -> OPENAI_API_KEY      (https://platform.openai.com/api-keys)
#   ollama     -> none (local, keyless)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# AI_API_KEY=

# --- Endpoint and model overrides (all optional) ---
# Point at any OpenAI-compatible root (usually ends in /v1) or Claude Messages root.
# Needed only for AI_PROVIDER=custom.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-sonnet-5
# Extra request headers as JSON, e.g. for OpenRouter attribution:
# AI_HEADERS={"X-Title":"NutriPlate"}
# Force the wire when using a custom endpoint: openai-completions | anthropic-messages
# AI_WIRE=openai-completions

# --- AI tuning (all optional) ---
AI_MAX_TOKENS=2500
AI_TEMPERATURE=0.2

# --- Server ---
PORT=3000
# Requests allowed per IP per window (protects your bill)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MIN=60
